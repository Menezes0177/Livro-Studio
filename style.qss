* { font-family: "Segoe UI"; }
QMainWindow { border: none; }
QWidget { outline: none; }

QPushButton { min-height: 46px; border-radius: 12px; padding: 10px 18px; font-size: 13px; font-weight: 700; }
QLineEdit, QTextEdit, QComboBox { min-height: 48px; border-radius: 13px; padding: 0 15px; font-size: 14px; }
QTextEdit { padding: 14px; }
QComboBox { padding-right: 38px; }
QComboBox::drop-down { width: 30px; border: none; }
QComboBox QAbstractItemView { padding: 6px; border-radius: 10px; }
QScrollArea, QAbstractScrollArea { border: none; }
QScrollBar:vertical { width: 11px; margin: 5px 3px; border: none; border-radius: 6px; }
QScrollBar::handle:vertical { min-height: 58px; border-radius: 6px; margin: 1px 0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; border: none; }
QScrollBar:horizontal { height: 11px; margin: 3px 5px; border: none; border-radius: 6px; }
QScrollBar::handle:horizontal { min-width: 58px; border-radius: 6px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal, QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; border: none; }

QWidget#appShell, QWidget#appChrome, QWidget#appNav, QWidget#homePage, QWidget#homeContent, QWidget#editorPage, QWidget#libraryPage, QWidget#explorerPage, QWidget#readerPage, QWidget#readerHolder { border: none; }
QLabel#pageTitle { font-size: 30px; font-weight: 850; }
QLabel#pageSubtitle { font-size: 13px; }
QLabel#readerTitle { font-size: 27px; font-weight: 800; }
QLabel#counter { font-size: 13px; }
QLabel#smallHint { font-size: 13px; }

QPushButton#navBrand { min-height: 50px; max-height: 50px; min-width: 50px; max-width: 50px; padding: 0; border-radius: 15px; font-size: 15px; font-weight: 900; }
QPushButton#navButton, QPushButton#navButtonSecondary { min-height: 48px; padding: 0 17px; border-radius: 12px; border: none; text-align: left; font-size: 13px; }
QPushButton#textButton { min-height: 38px; padding: 6px 8px; border: none; background: transparent; }
QLineEdit#searchInput { min-height: 50px; padding-left: 17px; }
QPushButton#deleteButton { min-height: 44px; }

QFrame#coverPicker { min-width: 250px; min-height: 350px; }
QLabel#coverPreview { min-width: 230px; min-height: 320px; }

/* HOME */
QLabel#homeKicker { font-size: 11px; font-weight: 800; letter-spacing: 2px; }
QLabel#homeTitle { font-size: 52px; font-weight: 900; line-height: 1.04; }
QLabel#homeSubtitle { font-size: 16px; font-weight: 500; }
QLabel#homeSection { font-size: 11px; font-weight: 800; letter-spacing: 1.5px; }
QPushButton#homeActionCard { min-height: 172px; border-radius: 18px; text-align: left; }
QLabel#homeCardTag { font-size: 10px; font-weight: 850; letter-spacing: 1.5px; }
QLabel#homeCardTitle { font-size: 22px; font-weight: 850; }
QLabel#homeCardDescription { font-size: 13px; line-height: 1.3; }
QLabel#homeCardArrow { font-size: 11px; font-weight: 850; letter-spacing: 1px; }
QFrame#homeTip { border-radius: 16px; }
QLabel#homeTipIcon { border-radius: 11px; font-weight: 900; }
QLabel#homeTipTitle { font-size: 14px; font-weight: 800; }
QLabel#homeTipText { font-size: 12px; }
QLabel#homeStatus, QLabel#homeVersion { font-size: 10px; font-weight: 700; letter-spacing: 1px; }

/* EXPLORER */
QFrame#explorerStatus { border-radius: 11px; }
QLabel#statusText { font-size: 12px; font-weight: 700; }
QLabel#counterBadge { min-width: 100px; padding: 9px 12px; border-radius: 11px; font-weight: 750; }
QFrame#explorerCard { min-width: 235px; max-width: 290px; min-height: 485px; max-height: 510px; border-radius: 17px; }
QLabel#explorerCover { border-radius: 12px; }
QLabel#explorerBookTitle { font-size: 17px; font-weight: 850; }
QLabel#explorerAuthor { font-size: 12px; }
QLabel#explorerSynopsis { font-size: 12px; }
QPushButton#explorerActionPrimary, QPushButton#explorerAction, QPushButton#explorerRemove { min-height: 40px; padding: 8px 10px; border-radius: 10px; font-size: 12px; }
QPushButton#explorerRemove { min-height: 36px; }
QFrame#explorerEmpty { min-height: 190px; border-radius: 18px; }
QLabel#emptyTitle { font-size: 21px; font-weight: 800; }
QPushButton#secondaryAction { min-height: 50px; }

QTextBrowser#readerText { border-radius: 20px; padding: 0; }
QDialog#appearanceDialog { border-radius: 18px; }
QLabel#dialogTitle { font-size: 22px; font-weight: 800; }

/* Perfil */
QLabel#profileAvatar {
    border: 2px solid #b86bd1;
    border-radius: 56px;
    background: #b86bd1;
}
QLabel#profileStatus { font-size: 13px; line-height: 1.35; }
QPushButton#subtleButton { min-height: 38px; padding: 0 14px; border-radius: 10px; }
